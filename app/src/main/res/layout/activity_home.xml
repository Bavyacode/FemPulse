<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4E0E9">

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:context=".HomeActivity">

            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical"
                >

                <ImageView
                    android:id="@+id/iconMenu"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/hamburger"
                    android:contentDescription="Menu Icon" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Hi, Bavya 👋"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/iconBell"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/reminder"
                    android:contentDescription="Reminder Icon" />
            </LinearLayout>

            <!-- Scrollable Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Current Phase -->
                    <LinearLayout
                        android:id="@+id/currentPhaseCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/currentphasehome"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/currentPhaseText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#000000"
                            android:textStyle="bold"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/currentPhaseDaysRemaining"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text=""
                            android:textColor="#555555"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/currentPhaseDateRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#555555"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/home_edit_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Edit Period"
                        android:layout_gravity="center"
                        android:background="@drawable/edittext_bg"
                        android:backgroundTint="@color/my_secondary"
                        android:layout_marginBottom="16dp"
                        />

                    <!-- Wellness Card -->
                    <LinearLayout
                        android:id="@+id/wellnessCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_bg"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/wellnessText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Wellness &amp; Self-Care\nEmbrace comfort and confidence!"
                            android:textColor="#000000"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/arrowright"
                            android:layout_gravity="center_vertical"
                            app:tint="#000000" />
                    </LinearLayout>

                    <!-- Next Period / Next Phase -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:id="@+id/nextPeriod"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/menstrual"
                            android:padding="16dp"
                            android:layout_marginEnd="8dp">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/calendar"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:id="@+id/nextPeriodLabel"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Next Period"
                                android:textColor="#000000"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/nextPeriodDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#555555"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/nextPhaseCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/menstrual"
                            android:backgroundTint="#E0F2F1"
                            android:padding="16dp"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:id="@+id/nextPhaseLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Next Phase"
                                android:textColor="#000000"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/nextPhaseText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#000000"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/nextPhaseDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#555555"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Phase Overview -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cycle Phase Overview"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginBottom="8dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/phaseMenstrual"
                                android:layout_width="150dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/overview"
                                android:backgroundTint="#EDB5C4"
                                android:padding="12dp"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:id="@+id/phaseMenstrualLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Menstrual"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:textColor="#000000" />

                                <TextView
                                    android:id="@+id/phaseMenstrualDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#555555"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/phaseFollicular"
                                android:layout_width="150dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/overview"
                                android:backgroundTint="#E0F2F1"
                                android:padding="12dp"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:id="@+id/phaseFollicularLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Follicular"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:textColor="#000000" />

                                <TextView
                                    android:id="@+id/phaseFollicularDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#555555"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/phaseOvulation"
                                android:layout_width="150dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/overview"
                                android:backgroundTint="#FFF3C4"
                                android:padding="12dp"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:id="@+id/phaseOvulationLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ovulation"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:textColor="#000000" />

                                <TextView
                                    android:id="@+id/phaseOvulationDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#555555"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/phaseLuteal"
                                android:layout_width="150dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/overview"
                                android:backgroundTint="#EDE6F7"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/phaseLutealLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Luteal"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:textColor="#000000" />

                                <TextView
                                    android:id="@+id/phaseLutealDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="#555555"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Cycle Snapshot -->
                    <TextView
                        android:text="Cycle Snapshot"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginBottom="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:background="#F5E8F1"
                        android:layout_marginBottom="16dp"
                        android:columnOrderPreserved="false">

                        <LinearLayout
                            android:id="@+id/snapshotLastPeriod"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:background="@drawable/snapshot"
                            android:padding="12dp"
                            android:layout_margin="4dp">

                            <TextView
                                android:id="@+id/snapshotLastPeriodLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Last Period"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:textSize="16sp" />
                            <TextView
                                android:id="@+id/snapshotLastPeriodValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#555555"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/snapshotCycleLength"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:background="@drawable/snapshot"
                            android:padding="12dp"
                            android:layout_margin="4dp">

                            <TextView
                                android:id="@+id/snapshotCycleLengthLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cycle Length"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:textSize="16sp" />
                            <TextView
                                android:id="@+id/snapshotCycleLengthValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#555555"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/snapshotPeriodLength"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:background="@drawable/snapshot"
                            android:padding="12dp"
                            android:layout_margin="4dp">

                            <TextView
                                android:id="@+id/snapshotPeriodLengthLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Period Length"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:textSize="16sp" />
                            <TextView
                                android:id="@+id/snapshotPeriodLengthValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#555555"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/snapshotPreviousPhase"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:background="@drawable/snapshot"
                            android:padding="12dp"
                            android:layout_margin="4dp">

                            <TextView
                                android:id="@+id/snapshotPreviousPhaseLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Previous Phase"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:textSize="16sp" />
                            <TextView
                                android:id="@+id/snapshotPreviousPhaseValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#555555"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </GridLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent History"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginBottom="8dp"/>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        app:cardElevation="4dp"
                        app:cardCornerRadius="12dp"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerViewRecentHistory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                tools:listitem="@layout/history"
                                android:padding="8dp"
                                tools:itemCount="3"/>

                            <!-- Divider Line -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#DDDDDD"
                                android:layout_marginTop="6dp"
                              />

                            <TextView
                                android:id="@+id/tvMoreHistory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="More"
                                android:textColor="@color/my_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:padding="8dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:layout_gravity="center"/>
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </LinearLayout>

    <!-- Side Drawer -->
    <LinearLayout
        android:id="@+id/drawer_menu"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        android:orientation="vertical">

        <include layout="@layout/activity_hamburgermenu" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
