<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F4E0E9">

    <!-- App Icon -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/calendar"
        android:layout_marginTop="40dp"
        app:tint="#FF4081" />

    <!-- Main Question -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What is the interval of your cycle?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="22dp" />

    <!-- Sub Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This is your full cycle length."
        android:textSize="14sp"
        android:textColor="#666"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <!-- Counter Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="-"
            android:textSize="24sp"
            />

        <TextView
            android:id="@+id/text_days"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text=""
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginHorizontal="12dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Help Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Knowing your cycle length helps us give you more\naccurate predictions"
        android:textSize="13sp"
        android:textColor="#888888"
        android:gravity="center"
        android:layout_marginTop="12dp" />

    <!-- Uncertain Text -->
    <TextView
        android:id="@+id/amnotsure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I'm not sure"
        android:textColor="@color/my_secondary"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:textStyle="italic" />

    <!-- Continue Button -->
    <Button
        android:id="@+id/btn_continue"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Continue"
        android:layout_marginTop="24dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:background="@drawable/rounded_button"
        android:layout_marginBottom="32dp" />
</LinearLayout>
