<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/leftarrow"
            android:layout_gravity="start"
            android:contentDescription="Back"
            android:layout_marginBottom="24dp"
            app:tint="@color/black" />

        <!-- Title -->
        <TextView
            android:id="@+id/forgot_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/forgot_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your registered email to receive 4 digit code"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <!-- Email Field -->
        <EditText
            android:id="@+id/edit_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:background="@drawable/edittext_background"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/email_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The code is incorrect"
            android:textColor="#ED4587"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingStart="4dp"
            android:visibility="gone" />


        <!-- Submit Button -->
        <Button
            android:id="@+id/btn_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send OTP"
            android:backgroundTint="@color/my_primary"
            android:textColor="@color/white"
            android:paddingVertical="12dp"
            android:layout_marginTop="8dp"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFF0F4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Info Icon"
                android:src="@drawable/info"
                app:tint="#ED4587" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Please check your inbox,we will send you a secure code"
                android:textColor="#ED4587"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
