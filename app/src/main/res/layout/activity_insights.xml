<!-- res/layout/activity_insights.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootInsights"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Page Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Insights"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/my_primary"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- NEW USER STATE -->
    <LinearLayout
        android:id="@+id/stateNewUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="16dp"
        android:background="#FFF5F5"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome!"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvNewUserMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Once you start logging your physical, mental, and behavioral symptoms, we’ll generate daily, weekly, and monthly insights tailored to your health journey."
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnStartLogging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log your first symptoms"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- INSUFFICIENT DATA STATE -->
    <LinearLayout
        android:id="@+id/stateInsufficient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFDEB"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep going!"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvInsufficientMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We need a bit more data to draw meaningful charts. Please log your upcoming cycles and symptoms regularly."
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- INSIGHTS CONTENT -->
    <ScrollView
        android:id="@+id/stateInsights"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">











            <!-- Top Symptoms -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top Symptoms"
                android:textColor="@color/my_primary"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"/>

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barTopSymptoms"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvTopPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log symptoms to unlock Top Symptoms insights"
                android:textAlignment="center"
                android:textColor="#888888"
                android:visibility="gone"
                android:padding="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Category Split -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Symptoms by Category"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"/>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pieCategory"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvCatPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log different symptoms to see category distribution"
                android:textAlignment="center"
                android:textColor="#888888"
                android:visibility="gone"
                android:padding="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Small facts -->
            <TextView
                android:id="@+id/tvFacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginTop="12dp"
                android:textSize="13sp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Refresh button at bottom -->
    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh Insights"
        android:background="@drawable/greyround"
        android:textColor="@color/my_primary"
        android:layout_marginTop="8dp"/>
</LinearLayout>
