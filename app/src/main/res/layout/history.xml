<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/curved_border_lightpink"
    android:gravity="center_vertical">

    <!-- Duration pink circle -->
    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="5"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/my_primary"
         />

    <!-- Dates + Interval -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp">

        <TextView
            android:id="@+id/tvDateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May 29 - Jun 02"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIntervalDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Interval: 31 days"
            android:textSize="14sp"
            android:textColor="@color/dark_grey" />
    </LinearLayout>

    <!-- Clock Icon -->
    <ImageView
        android:id="@+id/iconClock"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/clock"
        android:contentDescription="Cycle Icon" />

</LinearLayout>
